  Indexes {
    exam_id [name: 'ix_exam_results_exam']
    candidate_user_id [name: 'ix_exam_results_candidate']
    status [name: 'ix_exam_results_status']
    integrity_status [name: 'ix_exam_results_integrity']
  }
}

Table result_details {
  answered boolean [not null]
  is_correct boolean
  points_awarded numeric(9,2) [not null]
  points_possible numeric(9,2) [not null]
  sequence_no integer [not null]
  time_spent_seconds integer
  attempt_answer_id bigint
  created_at timestamptz [not null]
  exam_question_id bigint [not null]
  exam_result_id bigint [not null]
  exam_section_id bigint
  id bigint [pk, increment]
  updated_at timestamptz
  scoring_note varchar(500)

  Indexes {
    (exam_result_id, exam_question_id) [unique, name: 'uk_result_details_question']
  }
}

Table result_withholdings {
  created_at timestamptz [not null]
  exam_result_id bigint [not null]
  id bigint [pk, increment]
  released_at timestamptz
  released_by_user_id bigint
  review_case_id bigint
  risk_assessment_id bigint
  updated_at timestamptz
  withheld_at timestamptz [not null]
  withheld_by_user_id bigint
  reason WithholdingReason [not null]
  threshold_version varchar(32)
  release_reason varchar(1000)

  Indexes {
    (exam_result_id, released_at) [name: 'ix_result_withholdings_result']
  }
}

// ---- Proctoring Reports ----

Table proctoring_reports {
  includes_evidence boolean [not null]
  risk_score numeric(5,2)
  version integer [not null]
  created_at timestamptz [not null]
  exam_attempt_id bigint [not null]
  expires_at timestamptz
  generated_at timestamptz
  id bigint [pk, increment]
  proctoring_session_id bigint
  requested_at timestamptz [not null]
  requested_by_user_id bigint
  review_case_id bigint
  risk_assessment_id bigint
  size_bytes bigint
  updated_at timestamptz
  format ReportFormat [not null]
  public_id uuid [not null, unique]
  status ReportStatus [not null]
  final_integrity_status IntegrityStatus
  checksum_sha256 varchar(64)
  failure_reason varchar(500)
  storage_path varchar(512)
  summary_snapshot jsonb

  Indexes {
    (exam_attempt_id, version) [unique, name: 'uk_proctoring_reports_version']
    exam_attempt_id [name: 'ix_proctoring_reports_attempt']
    status [name: 'ix_proctoring_reports_status']
  }
}

Table attempt_timelines {
  entry_count integer [not null]
  version integer [not null]
  created_at timestamptz [not null]
  exam_attempt_id bigint [not null]
  generated_by_user_id bigint
  id bigint [pk, increment]
  rendered_at timestamptz [not null]
  updated_at timestamptz
  checksum_sha256 varchar(64)
  timeline_json jsonb

  Indexes {
    (exam_attempt_id, version) [unique, name: 'uk_attempt_timelines_version']
    exam_attempt_id [name: 'ix_attempt_timelines_attempt']
  }
}

// ---- Notifications ----

Table notifications {
  retry_count integer [not null]
  created_at timestamptz [not null]
  delivered_at timestamptz
  id bigint [pk, increment]
  next_retry_at timestamptz
  opened_at timestamptz
  recipient_user_id bigint [not null]
  related_entity_id bigint
  scheduled_for timestamptz
  sent_at timestamptz
  template_id bigint
  updated_at timestamptz
  channel NotificationChannel [not null]
  status NotificationStatus [not null]
  notification_type NotificationType [not null]
  related_entity_type varchar(48)
  idempotency_key varchar(128) [unique]
  provider_message_id varchar(128)
  failure_reason varchar(500)
  body varchar(8000) [not null]
  sent_to varchar(255) [not null]
  subject varchar(255)
  variables jsonb

  Indexes {
    (recipient_user_id, created_at) [name: 'ix_notifications_recipient']
    (status, next_retry_at) [name: 'ix_notifications_status']
    (related_entity_type, related_entity_id) [name: 'ix_notifications_related']
  }
}

Table notification_templates {
  is_active boolean [not null]
  version integer [not null]
  created_at timestamptz [not null]
  id bigint [pk, increment]
  locale varchar(8) [not null]
  updated_at timestamptz
  channel NotificationChannel [not null]
  notification_type NotificationType [not null]
  expected_variables varchar(500)
  body_template varchar(8000) [not null]
  subject_template varchar(255)

  Indexes {
    (notification_type, channel, locale) [unique, name: 'uk_notification_templates']
  }
}

Table notification_suppressions {
  is_active boolean [not null]
  max_per_window integer
  window_end_local time
  window_seconds integer
  window_start_local time
  created_at timestamptz [not null]
  created_by_user_id bigint
  id bigint [pk, increment]
  recipient_user_id bigint
  updated_at timestamptz
  channel NotificationChannel
  suppression_kind SuppressionKind [not null]
  notification_type NotificationType

  Indexes {
    recipient_user_id [name: 'ix_notification_suppressions_recipient']
  }
}

// ---- Audit ----

Table audit_logs {
  actor_user_id bigint
  created_at timestamptz [not null]
  entity_id bigint
  id bigint [pk, increment]
  occurred_at timestamptz [not null]
  updated_at timestamptz
  outcome AuditOutcome [not null]
  action AuditAction [not null]
  ip_address varchar(45)
  actor_role varchar(48)
  entity_type varchar(64) [not null]
  request_id varchar(64)
  user_agent varchar(512)
  reason varchar(1000)
  entity_label varchar(255)
  after_state jsonb
  before_state jsonb

  Indexes {
    (actor_user_id, occurred_at) [name: 'ix_audit_logs_actor']
    (entity_type, entity_id) [name: 'ix_audit_logs_entity']
    (action, occurred_at) [name: 'ix_audit_logs_action']
  }
}

// ---- AI Model Registry ----

Table ai_models {
  is_active boolean [not null]
  runs_on_client boolean [not null]
  created_at timestamptz [not null]
  id bigint [pk, increment]
  updated_at timestamptz
  purpose ModelPurpose [not null]
  code varchar(64) [not null, unique]
  vendor varchar(100)
  name varchar(150) [not null]
  description varchar(1000)

  Indexes {
    purpose [name: 'ix_ai_models_purpose']
  }
}

Table ai_model_versions {
  confidence_threshold numeric(5,4) [not null]
  detection_threshold numeric(5,4) [not null]
  activated_at timestamptz
  activated_by_user_id bigint
  ai_model_id bigint [not null]
  created_at timestamptz [not null]
  deprecated_at timestamptz
  id bigint [pk, increment]
  updated_at timestamptz
  status ModelVersionStatus [not null]
  version varchar(32) [not null]
  artifact_checksum varchar(64)
  artifact_ref varchar(512)
  release_notes varchar(2000)
  configuration jsonb

  Indexes {
    (ai_model_id, version) [unique, name: 'uk_ai_model_versions']
    status [name: 'ix_ai_model_versions_status']
  }
}

Table model_performance_metrics {
  metric_value numeric(12,4) [not null]
  ai_model_version_id bigint [not null]
  computed_at timestamptz [not null]
  created_at timestamptz [not null]
  false_negative_count bigint
  false_positive_count bigint
  id bigint [pk, increment]
  sample_count bigint [not null]
  true_positive_count bigint
  updated_at timestamptz
  window_end_at timestamptz [not null]
  window_start_at timestamptz [not null]
  metric_type MetricType [not null]
  note varchar(500)

  Indexes {
    (ai_model_version_id, metric_type, window_start_at) [unique, name: 'uk_model_performance']
    (ai_model_version_id, window_start_at) [name: 'ix_model_performance_version']
  }
}

Table shadow_evaluations {
  active_false_positive_rate numeric(6,4)
  shadow_false_positive_rate numeric(6,4)
  active_only_detections bigint [not null]
  active_version_id bigint [not null]
  agreement_count bigint [not null]
  computed_at timestamptz [not null]
  created_at timestamptz [not null]
  disagreement_count bigint [not null]
  id bigint [pk, increment]
  shadow_only_detections bigint [not null]
  shadow_version_id bigint [not null]
  updated_at timestamptz
  window_end_at timestamptz [not null]
  window_start_at timestamptz [not null]
  recommendation ShadowRecommendation

  Indexes {
    (shadow_version_id, active_version_id) [name: 'ix_shadow_evaluations_versions']
  }
}

// ---- System Configuration ----

Table system_settings {
  is_editable boolean [not null]
  is_secret boolean [not null]
  requires_restart boolean [not null]
  created_at timestamptz [not null]
  id bigint [pk, increment]
  last_changed_at timestamptz
  updated_at timestamptz
  updated_by_user_id bigint
  value_type SettingValueType [not null]
  category SettingCategory [not null]
  setting_key varchar(128) [not null, unique]
  description varchar(500)
  default_value varchar(4000)
  setting_value varchar(4000)
  validation_rule varchar(255)

  Indexes {
    category [name: 'ix_system_settings_category']
  }
}

Table risk_factor_configs {
  base_weight numeric(6,3) [not null]
  confidence_multiplier numeric(6,3) [not null]
  decay_half_life_seconds integer
  duration_weight_per_second numeric(6,3)
  frequency_increment numeric(6,3)
  grace_occurrences integer [not null]
  is_active boolean [not null]
  is_immediate_critical boolean [not null]
  max_contribution numeric(6,2)
  min_confidence numeric(5,4)
  created_at timestamptz [not null]
  effective_from timestamptz [not null]
  effective_to timestamptz
  id bigint [pk, increment]
  updated_at timestamptz
  severity EventSeverity [not null]
  config_version varchar(32) [not null]
  trigger_kind RiskFactorTrigger [not null]
  trigger_code varchar(48) [not null]
  factor_code varchar(64) [not null]
  factor_label varchar(150) [not null]

  Indexes {
    (factor_code, config_version) [unique, name: 'uk_risk_factor_configs']
    is_active [name: 'ix_risk_factor_configs_active']
    (trigger_kind, trigger_code) [name: 'ix_risk_factor_configs_trigger']
  }
}

Table risk_level_thresholds {
  alerts_proctor boolean [not null]
  is_active boolean [not null]
  max_score numeric(5,2)
  min_score numeric(5,2) [not null]
  opens_review_case boolean [not null]
  withholds_result boolean [not null]
  created_at timestamptz [not null]
  effective_from timestamptz [not null]
  effective_to timestamptz
  id bigint [pk, increment]
  updated_at timestamptz
  display_colour varchar(16)
  risk_level RiskLevel [not null]
  auto_action AutoAction [not null]
  config_version varchar(32) [not null]
  recommendation RiskRecommendation [not null]

  Indexes {
    (config_version, risk_level) [unique, name: 'uk_risk_level_thresholds']
    (is_active, min_score) [name: 'ix_risk_level_thresholds_active']
  }
}

