// ---- Exam Definition ----

Table exams {
  allowed_tab_switches integer
  auto_review_risk_threshold integer
  auto_terminate_risk_threshold integer
  block_copy_paste boolean [not null]
  detect_audio boolean [not null]
  detect_face boolean [not null]
  detect_gaze boolean [not null]
  detect_multiple_faces boolean [not null]
  detect_objects boolean [not null]
  detect_tab_switch boolean [not null]
  duration_minutes integer
  evidence_retention_days integer
  excel_autosave_interval_seconds integer
  excel_external_app_blocked boolean [not null]
  excel_iterative_calc_max_iterations integer
  excel_macros_allowed boolean [not null]
  excel_precision_as_displayed boolean [not null]
  excel_runtime_required boolean [not null]
  excel_snapshot_interval_minutes integer
  excel_volatile_functions_pinned boolean [not null]
  force_fullscreen boolean [not null]
  hold_results_for_review boolean [not null]
  max_attempts integer [not null]
  monitor_screen boolean [not null]
  passing_score numeric(9,2)
  require_environment_scan boolean [not null]
  require_identity_check boolean [not null]
  require_microphone boolean [not null]
  require_screen_share boolean [not null]
  require_webcam boolean [not null]
  retain_audio_transcript boolean [not null]
  show_result_immediately boolean [not null]
  shuffle_sections boolean [not null]
  total_points numeric(9,2)
  version integer [not null]
  closes_at timestamptz
  created_at timestamptz [not null]
  created_by_user_id bigint [not null]
  id bigint [pk, increment]
  opens_at timestamptz
  updated_at timestamptz
  excel_copy_paste_policy ExcelUiActionPolicy [not null]
  excel_cut_drag_fill_policy ExcelUiActionPolicy [not null]
  excel_recalc_mode ExcelRecalcMode [not null]
  public_id uuid [not null, unique]
  grading_mode GradingMode [not null]
  proctoring_mode varchar(32) [not null]
  status ExamStatus [not null]
  code varchar(64) [not null, unique]
  title varchar(200) [not null]
  description varchar(2000)
  instructions varchar(4000)

  Indexes {
    status [name: 'ix_exams_status']
    (opens_at, closes_at) [name: 'ix_exams_window']
  }
}

Table exam_sections {
  lock_on_exit boolean [not null]
  questions_to_draw integer
  section_points numeric(9,2)
  sequence_no integer [not null]
  shuffle_questions boolean [not null]
  time_limit_minutes integer
  created_at timestamptz [not null]
  exam_id bigint [not null]
  id bigint [pk, increment]
  updated_at timestamptz
  title varchar(150) [not null]
  description varchar(1000)
  instructions varchar(2000)

  Indexes {
    (exam_id, sequence_no) [unique, name: 'uk_exam_sections_order']
  }
}

Table exam_questions {
  negative_points numeric(9,2)
