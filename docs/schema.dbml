  required boolean [not null]
  sequence_no integer [not null]
  shuffle_options boolean [not null]
  created_at timestamptz [not null]
  exam_section_id bigint [not null]
  id bigint [pk, increment]
  question_id bigint [not null]
  updated_at timestamptz

  Indexes {
    (exam_section_id, question_id) [unique, name: 'uk_exam_questions_question']
    (exam_section_id, sequence_no) [unique, name: 'uk_exam_questions_order']
  }
}

Table exam_assignments {
  attempts_allowed integer
