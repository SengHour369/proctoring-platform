// ---- Authentication & Access ----

Table users {
  failed_login_count integer [not null]
  mfa_enabled boolean [not null]
  created_at timestamptz [not null]
  email_verified_at timestamptz
  id bigint [pk, increment]
  last_login_at timestamptz
  locale varchar(8)
  locked_until timestamptz
  mfa_enrolled_at timestamptz
  updated_at timestamptz
  mfa_method MfaMethod
  public_id uuid [not null, unique]
  phone_number varchar(32)
  status UserStatus [not null]
  external_ref varchar(64) [unique]
  time_zone varchar(64)
  full_name varchar(150) [not null]
  enrolment_photo_path varchar(512)
  voiceprint_path varchar(512)
  email varchar(255) [not null, unique]
  mfa_secret_encrypted varchar(255)
  password_hash varchar(255) [not null]

  Indexes {
    status [name: 'ix_users_status']
  }
}

Table roles {
  is_system boolean [not null]
  created_at timestamptz [not null]
  id bigint [pk, increment]
  updated_at timestamptz
  code varchar(48) [not null, unique]
  name varchar(100) [not null]
  description varchar(255)
}

Table permissions {
  is_system boolean [not null]
  created_at timestamptz [not null]
  id bigint [pk, increment]
  updated_at timestamptz
  action varchar(48) [not null]
  resource varchar(64) [not null]
  code varchar(100) [not null, unique]
  description varchar(255)

  Indexes {
    resource [name: 'ix_permissions_resource']
  }
}

Table role_permission {
  created_at timestamptz [not null]
  granted_at timestamptz [not null]
  granted_by_user_id bigint
  id bigint [pk, increment]
  permission_id bigint [not null]
  role_id bigint [not null]
  updated_at timestamptz

  Indexes {
    (role_id, permission_id) [unique, name: 'uk_role_permission']
  }
}

Table user_role {
  created_at timestamptz [not null]
  expires_at timestamptz
  granted_at timestamptz [not null]
  granted_by_user_id bigint
  id bigint [pk, increment]
  role_id bigint [not null]
  updated_at timestamptz
  user_id bigint [not null]

  Indexes {
    (user_id, role_id) [unique, name: 'uk_user_role']
  }
}

Table user_sessions {
  created_at timestamptz [not null]
  expires_at timestamptz [not null]
  id bigint [pk, increment]
  issued_at timestamptz [not null]
  last_seen_at timestamptz
  revoked_at timestamptz
  updated_at timestamptz
  user_id bigint [not null]
  ip_address varchar(45)
  device_fingerprint varchar(128)
  refresh_token_hash varchar(128) [not null, unique]
  revoked_reason varchar(128)
  user_agent varchar(512)

  Indexes {
    user_id [name: 'ix_user_sessions_user']
    expires_at [name: 'ix_user_sessions_expires']
  }
}

Table security_tokens {
  created_at timestamptz [not null]
  expires_at timestamptz [not null]
  id bigint [pk, increment]
  invalidated_at timestamptz
  issued_at timestamptz [not null]
  updated_at timestamptz
  used_at timestamptz
  user_id bigint [not null]
  purpose TokenPurpose [not null]
  redeemed_ip varchar(45)
  requested_ip varchar(45)
  token_hash varchar(128) [not null, unique]

  Indexes {
    (user_id, purpose) [name: 'ix_security_tokens_user']
    expires_at [name: 'ix_security_tokens_expires']
  }
}

Table login_attempts {
  geo_country varchar(2)
  attempted_at timestamptz [not null]
  created_at timestamptz [not null]
  id bigint [pk, increment]
  updated_at timestamptz
  user_id bigint
  outcome LoginOutcome [not null]
  ip_address varchar(45)
  device_fingerprint varchar(128)
  user_agent varchar(512)
  email varchar(255) [not null]
  failure_detail varchar(255)

  Indexes {
    (email, attempted_at) [name: 'ix_login_attempts_email_time']
    (ip_address, attempted_at) [name: 'ix_login_attempts_ip_time']
    user_id [name: 'ix_login_attempts_user']
  }
}

Table api_clients {
  rate_limit_per_minute integer
  created_at timestamptz [not null]
  created_by_user_id bigint
  expires_at timestamptz
  id bigint [pk, increment]
  last_used_at timestamptz
  revoked_at timestamptz
  secret_rotated_at timestamptz
  updated_at timestamptz
  status ApiClientStatus [not null]
  last_used_ip varchar(45)
  client_id varchar(64) [not null, unique]
  client_secret_hash varchar(128) [not null, unique]
  name varchar(150) [not null]
  allowed_ip_ranges varchar(500)
  description varchar(500)
  allowed_scopes varchar(1000) [not null]
  revoked_reason varchar(255)

  Indexes {
    status [name: 'ix_api_clients_status']
  }
}

// ---- Payment ----

Table payment_customers {
  billing_country varchar(2)
  is_delinquent boolean [not null]
  preferred_currency varchar(3)
  created_at timestamptz [not null]
  default_payment_card_id bigint
  id bigint [pk, increment]
  updated_at timestamptz
  user_id bigint [not null]
  provider PaymentProvider [not null]
  public_id uuid [not null]
  billing_phone varchar(32)
  billing_postal_code varchar(32)
  tax_id varchar(64)
  billing_city varchar(100)
  billing_state varchar(100)
  provider_customer_id varchar(128) [not null]
  billing_name varchar(150)
  billing_address_line1 varchar(200)
  billing_address_line2 varchar(200)
  billing_email varchar(255)
  metadata jsonb

  Indexes {
    (user_id, provider) [unique, name: 'uk_payment_customers_user_provider']
    (provider, provider_customer_id) [unique, name: 'uk_payment_customers_provider_customer']
    user_id [name: 'ix_payment_customers_user']
  }
}

Table payment_cards {
  billing_country varchar(2)
  expiry_month integer [not null]
  expiry_year integer [not null]
  is_default boolean [not null]
  issuer_country varchar(2)
  last4 varchar(4) [not null]
  three_ds_enrolled boolean [not null]
  three_ds_supported boolean [not null]
  bin varchar(8)
  created_at timestamptz [not null]
  id bigint [pk, increment]
  last_used_at timestamptz
  payment_customer_id bigint [not null]
  revoked_at timestamptz
  updated_at timestamptz
  user_id bigint [not null]
  avs_line1_check PaymentCardholderVerification [not null]
  avs_postal_code_check PaymentCardholderVerification [not null]
  brand CardBrand [not null]
  cvv_check PaymentCardholderVerification [not null]
  funding PaymentCardFunding [not null]
  provider PaymentProvider [not null]
  public_id uuid [not null]
  billing_postal_code varchar(20)
  status PaymentCardStatus [not null]
  fingerprint varchar(128)
  provider_card_token varchar(128)
  provider_payment_method_id varchar(128) [not null]
  cardholder_name varchar(150)
  issuer varchar(150)
  revoked_reason varchar(255)
  metadata jsonb

  Indexes {
    (provider, provider_payment_method_id) [unique, name: 'uk_payment_cards_provider_method']
    (payment_customer_id, status) [name: 'ix_payment_cards_customer']
    (user_id, status) [name: 'ix_payment_cards_user']
    fingerprint [name: 'ix_payment_cards_fingerprint']
  }
}

Table payment_transactions {
  currency varchar(3) [not null]
  three_ds_authenticated boolean [not null]
  amount_minor bigint [not null]
  amount_refunded_minor bigint [not null]
  captured_at timestamptz
  created_at timestamptz [not null]
  id bigint [pk, increment]
  initiated_by_user_id bigint
  parent_transaction_id bigint
  payment_card_id bigint
  payment_customer_id bigint [not null]
  updated_at timestamptz
  provider PaymentProvider [not null]
  public_id uuid [not null]
  type PaymentTransactionType [not null]
  statement_descriptor varchar(22)
  status PaymentTransactionStatus [not null]
  failure_code varchar(64)
  reference varchar(64)
  idempotency_key varchar(128)
  provider_intent_id varchar(128)
  provider_transaction_id varchar(128) [not null]
  description varchar(500)
  failure_message varchar(500)
  metadata jsonb

  Indexes {
    (provider, provider_transaction_id) [unique, name: 'uk_payment_transactions_provider_txn']
    idempotency_key [unique, name: 'uk_payment_transactions_idempotency_key']
    (payment_customer_id, created_at) [name: 'ix_payment_transactions_customer']
    (payment_card_id, created_at) [name: 'ix_payment_transactions_card']
    (status, created_at) [name: 'ix_payment_transactions_status']
    parent_transaction_id [name: 'ix_payment_transactions_parent']
    reference [name: 'ix_payment_transactions_reference']
  }
}

